#!/bin/bash
set -e

echo "Running pre-commit checks..."

echo "→ make fmt"
make fmt

# Check if any Go files were modified by fmt
if ! git diff --quiet -- '*.go' 2>/dev/null; then
  echo "Files changed after 'make fmt'. Stage the changes and try again."
  exit 1
fi

echo "→ make tidy"
make tidy

# Check if go.mod or go.sum were modified by tidy
if ! git diff --quiet go.mod go.sum 2>/dev/null; then
  echo "go.mod or go.sum changed after 'make tidy'. Stage the changes and try again."
  exit 1
fi

echo "→ make vet"
make vet

echo "→ make lint"
make lint

echo "→ make test"
make test

echo "All checks passed."

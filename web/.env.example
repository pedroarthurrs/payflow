# ============================================================
# payflow Frontend — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# ============================================================

# API proxy target for local development (Vite dev server only)
# In production, configure the reverse proxy (nginx/caddy) directly
VITE_API_URL=http://localhost:8080

# Optional: override proxy target explicitly (takes precedence over VITE_API_URL)
# VITE_API_PROXY_TARGET=http://localhost:8080

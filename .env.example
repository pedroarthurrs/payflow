GO_ENV=development # development OR staging OR production

# ----------------------------------------------------------- #
# ----------------------- DEVELOPMENT ----------------------- #
# ----------------------------------------------------------- #

# APLICATION
PORT_DEV=8080

# AUTHENTICATION
JWT_SECRET_DEV= :O

# DATABASE
DB_USER_DEV=user
DB_PASSWORD_DEV=password
DB_HOST_DEV=host
DB_NAME_DEV=name
DB_PORT_DEV=0001

# RATE LIMIT
RATE_LIMIT_WINDOW_SECONDS_DEV=60
RATE_LIMIT_MAX_REQUESTS_DEV=100
RATE_LIMIT_LOGIN_WINDOW_SECONDS_DEV=300
RATE_LIMIT_LOGIN_MAX_REQUESTS_DEV=5
RATE_LIMIT_TENANT_WINDOW_SECONDS_DEV=60
RATE_LIMIT_TENANT_MAX_REQUESTS_DEV=200


# ----------------------------------------------------------- #
# ----------------------- PRODUCTION ------------------------ #
# ----------------------------------------------------------- #

# APLICATION
PORT=8080

# AUTHENTICATION
JWT_SECRET= >:/

# DATABASE
DB_USER=user
DB_PASSWORD=password
DB_HOST=host
DB_NAME=name
DB_PORT=0001

# RATE LIMIT
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_MAX_REQUESTS=5
RATE_LIMIT_TENANT_WINDOW_SECONDS=60
RATE_LIMIT_TENANT_MAX_REQUESTS=200
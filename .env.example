GO_ENV=development # development | staging | production

# APPLICATION
SERVER_PORT=8080

# AUTHENTICATION
JWT_SECRET=change-me-production-secret-min-32-chars

# API Key hashing (required — CredentialService panics if empty)
API_KEY_PEPPER=change-me-pepper-secret

# DATABASE
DB_DRIVER=postgres
DB_DSN=
DB_USER=user
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
DB_NAME=payflow
DB_SSLMODE=disable

# PAYMENT GATEWAY
GATEWAY_PROVIDER_NAME=   # e.g. stripe
GATEWAY_PROVIDER_API_KEY=

# OBSERVABILITY (optional)
SENTRY_DSN=

# FEATURE FLAGS (optional)
FEATURE_MAINTENANCE=false

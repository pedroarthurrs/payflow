GO_ENV=development # development | staging | production

# APPLICATION
SERVER_PORT=8080

# AUTHENTICATION
JWT_SECRET=change-me-production-secret-min-32-chars

# API Key hashing
API_KEY_PEPPER=

# DATABASE
DB_DRIVER=postgres
DB_DSN=
DB_USER=user
DB_PASSWORD=change-me
DB_HOST=db
DB_NAME=i9pay
DB_SSLMODE=disable
DB_PORT=5432

# RATE LIMITE
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_MAX_REQUESTS=5
RATE_LIMIT_ORGANIZATION_WINDOW_SECONDS=60
RATE_LIMIT_ORGANIZATION_MAX_REQUESTS=200

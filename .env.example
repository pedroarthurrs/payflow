GO_ENV=development # development | staging | production

# ----------------------------------------------------------- #
# ----------------------- DEVELOPMENT ----------------------- #
# ----------------------------------------------------------- #

# APPLICATION
SERVER_PORT_DEV=8080

# AUTHENTICATION
JWT_SECRET_DEV=change-me-dev-secret-min-32-chars

# DATABASE
DB_USER_DEV=i9pay
DB_PASSWORD_DEV=i9pay_password
DB_HOST_DEV=postgres
DB_NAME_DEV=i9pay_dev
DB_PORT_DEV=5432

# ----------------------------------------------------------- #
# ------------------------- STAGING ------------------------- #
# ----------------------------------------------------------- #

# APPLICATION
SERVER_PORT_STAGING=8080

# AUTHENTICATION
JWT_SECRET_STAGING=change-me-staging-secret-min-32-chars

# DATABASE
DB_USER_STAGING=i9pay
DB_PASSWORD_STAGING=i9pay_staging_password
DB_HOST_STAGING=postgres
DB_NAME_STAGING=i9pay_staging
DB_PORT_STAGING=5432

# ----------------------------------------------------------- #
# ----------------------- PRODUCTION ------------------------ #
# (Em produção prefira injetar via secrets do orquestrador)  #
# ----------------------------------------------------------- #

# APPLICATION
SERVER_PORT=8080

# AUTHENTICATION
JWT_SECRET=change-me-production-secret-min-32-chars

# DATABASE
DB_USER=i9pay
DB_PASSWORD=i9pay_production_password
DB_HOST=postgres
DB_NAME=i9pay_prod
DB_PORT=5432

# ----------------------------------------------------------- #
# ------------------- RATE LIMIT (global) ------------------- #
# Estas variáveis NÃO usam sufixo de ambiente.               #
# ----------------------------------------------------------- #

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_MAX_REQUESTS=5
RATE_LIMIT_TENANT_WINDOW_SECONDS=60
RATE_LIMIT_TENANT_MAX_REQUESTS=200
